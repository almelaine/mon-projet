{
  "extraKnownMarketplaces": {
    "ecc": {
      "source": { "source": "directory", "path": "/opt/ecc" }
    }
  },
  "enabledPlugins": {
    "ecc@ecc": true
  },
  "permissions": {
    "allow": [
      "WebSearch",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:api.github.com)",
      "WebFetch(domain:raw.githubusercontent.com)",

      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git branch*)",

      "Bash(uv *)",
      "Bash(ruff *)",
      "Bash(mypy *)",
      "Bash(pytest *)",
      "Bash(python -m pytest *)",
      "Bash(npm test*)",
      "Bash(npm run test*)",
      "Bash(node --test *)",
      "Bash(docker *)",
      "Bash(ssh-add -l)"
    ]
  }
}
